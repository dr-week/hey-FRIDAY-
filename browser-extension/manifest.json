{
  "manifest_version": 3,
  "name": "Hey FRIDAY - Web Voice AI & Access Point",
  "version": "2.1.0",
  "description": "Zero-latency voice assistant, disfluency reframing, and AI agent access point for any webpage.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:4141/*",
    "http://localhost:4141/*",
    "https://dr-week.github.io/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Hey FRIDAY"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
